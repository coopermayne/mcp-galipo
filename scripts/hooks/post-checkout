#!/bin/bash

# Post-checkout hook: auto-setup new worktrees
#
# Git calls this hook after `git worktree add` with:
#   $1 = previous HEAD
#   $2 = new HEAD
#   $3 = 1 (branch checkout) or 0 (file checkout)

BRANCH_CHECKOUT="$3"

# Only run on branch checkouts (not file checkouts)
[ "$BRANCH_CHECKOUT" = "0" ] && exit 0

# Detect if this is a worktree (not the main repo)
MAIN_REPO="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null | sed 's|/\.git$||')"
WORKTREE_DIR="$(pwd)"

[ "$WORKTREE_DIR" = "$MAIN_REPO" ] && exit 0

# Run setup if .env doesn't exist yet (first checkout = new worktree)
if [ ! -f "$WORKTREE_DIR/.env" ]; then
    SETUP_SCRIPT="$MAIN_REPO/scripts/setup-worktree.sh"
    if [ -x "$SETUP_SCRIPT" ]; then
        echo ""
        echo "New worktree detected — running setup..."
        "$SETUP_SCRIPT"
    fi
fi
