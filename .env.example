# Copy this file to .env and fill in your values
# cp .env.example .env

# Required
DATABASE_URL=postgresql://YOUR_USER@localhost:5432/galipo
AUTH_USERNAME=admin
AUTH_PASSWORD=changeme

# Ports (change for multi-repo setup - see CLAUDE.md)
PORT=8000
VITE_PORT=5173

# Google Sheets intake sync
# Option A: path to service account JSON key file (recommended)
# GOOGLE_SHEETS_CREDENTIALS_FILE=google-credentials.json
# Option B: inline JSON (tricky with shell quoting)
# GOOGLE_SHEETS_CREDENTIALS_JSON={"type":"service_account",...}
# GOOGLE_SHEETS_SPREADSHEET_ID=your-spreadsheet-id

# Optional
# ANTHROPIC_API_KEY=sk-...
# CHAT_MODEL=claude-haiku-4-5
# EXTRACTION_MODEL=claude-haiku-4-5-20251001
# WEBHOOK_SECRET_COURTLISTENER=your-secret
# MCP_AUTH_PASSWORD=your-password
# MCP_BASE_URL=https://your-public-url.example.com
