# Copy this file to .env and fill in your values
# cp .env.example .env

# Required
DATABASE_URL=postgresql://YOUR_USER@localhost:5432/galipo
AUTH_USERNAME=admin
AUTH_PASSWORD=changeme

# Ports (change for multi-repo setup - see CLAUDE.md)
PORT=8000
VITE_PORT=5173

# Dev auth bypass (skip login during development)
DEV_SKIP_AUTH=true
VITE_DEV_SKIP_AUTH=true
DEV_AUTH_USER=your.email@example.com

# Optional
# ANTHROPIC_API_KEY=sk-...
# CHAT_MODEL=claude-haiku-4-5
# WEBHOOK_SECRET_COURTLISTENER=your-secret
# MCP_AUTH_PASSWORD=your-password
# MCP_BASE_URL=https://your-public-url.example.com
